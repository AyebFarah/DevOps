pipeline {
    agent any

    environment {
        DOCKERHUB_USER = 'ayebfarah'
        IMAGE_NAME     = "${DOCKERHUB_USER}/counter-app"
        IMAGE_TAG      = "${env.BUILD_NUMBER}"
        APP_DIR        = 'Conteneurisation et Orchestration Micro-services/TP1_Docker'
    }

    triggers {
        githubPush()
        pollSCM('* * * * *')
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Tests unitaires') {
            steps {
                dir("${APP_DIR}") {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        python -m pip install --no-cache-dir -r requirements.txt pytest
                        python -m pytest -v --junitxml=test-results.xml
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${APP_DIR}/test-results.xml"
                }
            }
        }

        stage('Build image Docker') {
            when {
                anyOf {
                    branch 'main'
                    expression { env.GIT_BRANCH == 'origin/main' }
                }
            }
            steps {
                dir("${APP_DIR}") {
                    sh 'docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -t ${IMAGE_NAME}:latest .'
                }
            }
        }

        stage('Publication Docker Hub') {
            when {
                anyOf {
                    branch 'main'
                    expression { env.GIT_BRANCH == 'origin/main' }
                }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DH_USER',
                    passwordVariable: 'DH_PASS')]) {
                    sh '''
                        echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest
                    '''
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo "Image publiee : ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo 'Pipeline en echec : consulter les logs.'
        }
    }
}
