{
  "uid": "tp4-gitops",
  "title": "TP4 - GitOps, ArgoCD & Workloads",
  "tags": [
    "tp4",
    "argocd",
    "gitops"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(argocd_app_info, dest_namespace)",
          "refId": "ns"
        },
        "definition": "label_values(argocd_app_info, dest_namespace)",
        "refresh": 2,
        "current": {
          "text": "podinfo-prod",
          "value": "podinfo-prod"
        },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Sync ArgoCD",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "blue",
        "expr": "sum by (name) (changes(argocd_app_sync_total{name=\"podinfo-prod\"}[1m])) > 0",
        "step": "30s",
        "titleFormat": "Sync ArgoCD",
        "textFormat": "{{name}} synchronisée depuis Git"
      },
      {
        "name": "Changement de Health",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "argocd_app_info{name=\"podinfo-prod\"} unless argocd_app_info{name=\"podinfo-prod\"} offset 1m",
        "step": "30s",
        "titleFormat": "{{health_status}} / {{sync_status}}",
        "textFormat": "podinfo-prod : nouvel état"
      },
      {
        "name": "Alertes TP4",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "ALERTS{alertname=~\"TP4.*\", alertstate=\"firing\"}",
        "step": "30s",
        "titleFormat": "{{alertname}}",
        "textFormat": "Alerte en Firing"
      }
    ]
  },
